SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

CRON_SECRET=

# Clasificación de mensajes entrantes de WhatsApp (lib/whatsapp/intent.ts) y
# del tipo de incidencia (lib/ia/clasificar-incidencia.ts).
# Solo servidor: nunca NEXT_PUBLIC_. Sin ella, todo mensaje que no sea palabra
# clave de fichaje entra como incidencia sin clasificar.
ANTHROPIC_API_KEY=

# Transcripción con Whisper de las notas de voz (lib/ia/transcribir-audio.ts).
# Solo servidor. Sin ella los audios se registran igual, pero sin descripción:
# el bot le pide al operario que cuente por escrito qué ha pasado.
OPENAI_API_KEY=
